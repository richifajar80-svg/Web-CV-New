# Konfigurasi Pengiriman Email Gmail (cvbagus.id)
GMAIL_USER=no-reply.cvbagus@gmail.com
# Masukkan 16 karakter App Password dari akun Google (contoh: abcd efgh ijkl mnop)
# Cara membuat: Buka myaccount.google.com -> Keamanan -> Verifikasi 2 Langkah -> Sandi Aplikasi (App Passwords)
GMAIL_APP_PASSWORD=

# URL Website Resmi
NEXT_PUBLIC_SITE_URL=https://cvbagus.id

# Google Gemini AI API Key (Untuk fitur Translate Deskripsi Kerja Profesional Standar ATS)
# Dapatkan API Key 100% Gratis di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Google Sign-In (OAuth 2.0 Web Client ID)
# Buat di Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth client ID (Web application)
# Authorized JavaScript origins: https://cvbagus.id, https://www.cvbagus.id, http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Midtrans Payment Gateway
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=true


